# /etc/default/mihomo-manager  —  read by mihomo-manager.service and mihomo-sub-update.service
# Keep this file root-only (chmod 600) if you put secrets in it.

# mihomo working directory (config.yaml / override.yaml / backup/ / geo databases)
#MIHOMO_DIR=/etc/mihomo
# mihomo binary (kernel update replaces this file, old versions are kept as <bin>.bak.<version>)
#MIHOMO_BIN=/usr/local/bin/mihomo
# systemd unit name of the mihomo daemon
#MIHOMO_SERVICE=mihomo

# Listen address of the web manager. 0.0.0.0 exposes it to the whole LAN:
# set a strong password, or use 127.0.0.1:9092 behind a reverse proxy with TLS.
#MANAGER_LISTEN=0.0.0.0:9092

# HTTP Basic auth. Password: MANAGER_PASSWORD, otherwise the first line of MANAGER_SECRET_FILE.
# If neither is set the manager runs WITHOUT authentication.
#MANAGER_USER=admin
#MANAGER_PASSWORD=
#MANAGER_SECRET_FILE=/etc/mihomo/manager.secret

# Dedicated token for browser auto-login and Authorization: Bearer API requests.
# Open http://<server>:9092/login#token=<token> to start a browser session.
# The token is independent of the password and the mihomo controller secret.
#MANAGER_TOKEN=
#MANAGER_TOKEN_FILE=/etc/mihomo/manager.token
# Session lifetime in seconds (default: 7 days). Rotating the token revokes all sessions.
#MANAGER_SESSION_MAX_AGE=604800

# Subscription URL. Prefer the file (chmod 600) over putting the URL here.
#MIHOMO_SUB_URL=https://example.com/your/subscription/link
#MIHOMO_SUB_URL_FILE=/etc/mihomo/subscription.url

# Location of helper scripts (default: same directory as manager.py)
#MERGE_SCRIPT=/etc/mihomo/merge-config.py
#UPDATE_SCRIPT=/etc/mihomo/update-subscription.sh

# Number of config.yaml backups kept by update-subscription.sh
#BACKUP_KEEP=20

# How update-subscription.sh applies a new config.
#   reload  (default) hot reload via the controller, falling back to a restart if that fails.
#                     Keeps the tun device, so tun.auto-route routes survive and other tunnels
#                     on this host (e.g. Tailscale) do not see a link change and reset peers.
#   restart           always `systemctl restart` (previous behaviour).
#MIHOMO_APPLY_MODE=reload

