[Unit]
Description=mihomo-keeper web manager (subscription / override / backup / service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The manager needs root: it runs systemctl/journalctl and writes to MIHOMO_DIR / MIHOMO_BIN.
User=root
WorkingDirectory=/etc/mihomo
# Defaults; override them in /etc/default/mihomo-manager (see manager.env.example).
Environment=MIHOMO_DIR=/etc/mihomo
Environment=MANAGER_LISTEN=0.0.0.0:9092
EnvironmentFile=-/etc/default/mihomo-manager
ExecStart=/usr/bin/python3 /etc/mihomo/manager.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
